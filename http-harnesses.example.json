{
  "harnesses": [
    {
      "id": "pi",
      "endpoint": "https://api.inflection.ai/v1/chat/completions",
      "api_key_env": "PI_API_KEY",
      "default_model": "inflection_3_pi",
      "models": ["inflection_3_pi", "inflection-2.5"],
      "response_format": "openai_sse",
      "strengths": "Conversational synthesis, product critique, and clear technical writing"
    },
    {
      "id": "openrouter",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_API_KEY",
      "default_model": "deepseek/deepseek-r1",
      "models": ["deepseek/deepseek-r1", "qwen/qwen3-coder"],
      "response_format": "openai_sse",
      "strengths": "Unified OpenAI-compatible multi-vendor HTTP gateway"
    }
  ]
}
