{
  "mcpServers": {
    "hub": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"${EXT_MODELS_BIN:-$HOME/.gemini/config/plugins/external-model-subagents/bin/ext-models-mcp}\" mcp"
